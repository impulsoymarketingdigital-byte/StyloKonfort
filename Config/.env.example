<?php
/**
 * STYLOKONFORT — Template de configuración
 * 
 * Copia este archivo a Config/.env y rellena con tus valores reales.
 * NUNCA subas Config/.env a GitHub.
 * En Docker/Dokploy inyecta estas variables directamente como ENV.
 */

# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ecomerce

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_URL=http://localhost/ecomerce/
APP_NAME=Stylo Konfort
APP_MONEDA=COP.
APP_CURRENCY=COP
APP_POR_PAGINA=12
APP_MAX_PRECIO=5000000
APP_DEBUG=false

# ─── WOMPI (única pasarela de pagos) ─────────────────────────────────────────
# Obtén tus claves en: https://comercios.wompi.co
# Ambiente: sandbox | production
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_stagtest_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_stagtest_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=stagtest_integrity_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=stagtest_events_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Email SMTP ───────────────────────────────────────────────────────────────
SMTP_FROM=ventas@stylokonfort.com
SMTP_USER=ventas@stylokonfort.com
SMTP_PASS=tu_contraseña_smtp_aqui
SMTP_PORT=465
SMTP_HOST=mail.stylokonfort.com
