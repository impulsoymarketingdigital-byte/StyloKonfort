# ─── Control de versiones ─────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Archivos de desarrollo ───────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project

# ─── Documentación y scripts locales ─────────────────────────────────────────
README.md
*.md
docs/

# ─── Archivos pesados innecesarios en producción ──────────────────────────────
*.zip
*.tar.gz
ecomerce.zip
ecomerce/

# ─── Archivos de base de datos (no van en la imagen Docker) ──────────────────
*.sql
BD_ECOMERCE/

# ─── Configuración sensible (se inyectan como ENV en Docker/Dokploy) ─────────
Config/.env
Config/- copia.env
Config/Config - copia.php

# ─── Dependencias (se instalan durante el build) ────────────────────────────
# vendor/ NO se excluye — se instala con composer install en el Dockerfile

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

